# Base URL of the NestJS CV Portfolio backend API
CV_API_BASE_URL=http://localhost:3001/api

# Credentials for the ai-agent role
CV_USERNAME=ai-agent
CV_PASSWORD=your-ai-agent-password-here

# MCP server name (shown in client)
CV_SERVER_NAME=cv-mcp-server

# Set this to enable HTTP transport (stdio is default)
# CV_HTTP_PORT=3002
